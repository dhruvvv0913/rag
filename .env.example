# Copy the values you need into .env.local (gitignored). Keys are read ONLY
# inside /api functions via process.env — never in frontend code.

# LLM (default provider)
GEMINI_API_KEY=
LLM_PROVIDER=gemini          # gemini | anthropic
# GEMINI_CHAT_MODEL=gemini-3.1-flash-lite   # optional override; lite tier has the biggest free daily quota
# Optional upgrade (Phase 3+)
ANTHROPIC_API_KEY=

# Supabase (Phase 2)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server-only, never in frontend

# Web search tool (Phase 3)
SEARCH_API_KEY=
